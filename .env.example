# Kyro Environment Configuration

# Backend & Server Settings
KYRO_ENV=development
KYRO_PORT=8000
KYRO_HOST=127.0.0.1
KYRO_DEBUG=true

# AI Provider Keys (Optional for Cloud AI)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Local AI / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=false

# Voice Engine Settings
VOICE_ENGINE_ENABLED=false
TTS_PROVIDER=local
STT_PROVIDER=local

# Paths
KYRO_DATA_DIR=./data
KYRO_LOG_DIR=./data/logs
