{
  "name": "kyro-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Kyro - AI Desktop Assistant & Agent",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,DESKTOP\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:backend\" \"npm run dev:desktop\"",
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "dev:backend": "bash scripts/dev/start_backend.sh",
    "build:desktop": "npm --prefix apps/desktop run build",
    "test": "npm --prefix apps/desktop test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "author": "Kyro Team",
  "license": "MIT"
}
